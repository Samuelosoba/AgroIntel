{
  "name": "agrointel",
  "private": true,
  "description": "AgroIntel — AI-powered smart farming platform",
  "workspaces": [
    "app",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:app": "npm run dev -w app",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w server && npm run build -w app",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w server && npm run typecheck -w app",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server"
  },
  "engines": {
    "node": ">=20"
  }
}
