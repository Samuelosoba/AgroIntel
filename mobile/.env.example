# A phone can't reach "localhost" on your computer — use your computer's LAN IP,
# e.g. http://192.168.1.20:4000/api/v1 (run `ipconfig` to find it).
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/v1
# Fallback position when GPS is off and no farm exists yet
EXPO_PUBLIC_DEFAULT_LAT=9.0765
EXPO_PUBLIC_DEFAULT_LON=7.3986
EXPO_PUBLIC_DEFAULT_PLACE=Abuja
