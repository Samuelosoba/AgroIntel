# API the app talks to. Defaults to the live backend when unset.
# To use a server on your computer instead, a phone can't reach "localhost" —
# use your computer's LAN IP, e.g. http://192.168.1.20:4000/api/v1 (run `ipconfig`).
EXPO_PUBLIC_API_URL=https://agrointel-api.vercel.app/api/v1
# Fallback position when GPS is off and no farm exists yet
EXPO_PUBLIC_DEFAULT_LAT=9.0765
EXPO_PUBLIC_DEFAULT_LON=7.3986
EXPO_PUBLIC_DEFAULT_PLACE=Abuja
